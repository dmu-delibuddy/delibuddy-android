rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 동양미래대 이메일 인증을 마친 사용자 (firestore.rules 와 같은 조건)
    function isStudent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@dongyang[.]ac[.]kr$');
    }

    match /recommend-locations/{imageId} {
      allow read: if true;
    }

    // 올릴 때 customMetadata.ownerId 에 내 uid 를 넣고, 지우기는 올린 사람만
    match /images/{imageId} {
      allow read: if isStudent();
      allow create: if isStudent()
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.metadata.ownerId == request.auth.uid;
      allow delete: if isStudent()
                    && resource.metadata.get('ownerId', '') == request.auth.uid;
    }
  }
}
