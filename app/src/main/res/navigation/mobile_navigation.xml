<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.delibuddy.ui.home.HomeFragment"
        android:label="@string/home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_recommendation"
        android:name="com.example.delibuddy.ui.recommendation.RecommendationFragment"
        android:label="@string/location_recommendation"
        tools:layout="@layout/fragment_recommendation" />

    <fragment
        android:id="@+id/navigation_chat"
        android:name="com.example.delibuddy.ui.chat.ChatFragment"
        android:label="@string/chatting"
        tools:layout="@layout/fragment_chat" />

    <fragment
        android:id="@+id/navigation_mypage"
        android:name="com.example.delibuddy.ui.mypage.MyPageFragment"
        android:label="@string/my_page"
        tools:layout="@layout/fragment_mypage" />

</navigation>
