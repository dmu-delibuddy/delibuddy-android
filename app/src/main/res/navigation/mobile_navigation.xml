<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_startup">

    <fragment
        android:id="@+id/navigation_startup"
        android:name="com.example.delibuddy.ui.startup.StartupFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_startup">
        <action
            android:id="@+id/action_startup_to_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/navigation_startup"
            app:popUpToInclusive="true"
            app:launchSingleTop="true" />
        <action
            android:id="@+id/action_startup_to_auth_entry"
            app:destination="@id/navigation_auth_entry"
            app:popUpTo="@id/navigation_startup"
            app:popUpToInclusive="true"
            app:launchSingleTop="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_auth_entry"
        android:name="com.example.delibuddy.ui.authentry.AuthEntryFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_auth_entry">
        <action
            android:id="@+id/action_auth_entry_to_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/navigation_auth_entry"
            app:popUpToInclusive="true"
            app:launchSingleTop="true" />
        <action
            android:id="@+id/action_auth_entry_to_signup"
            app:destination="@id/navigation_signup" />
        <action
            android:id="@+id/action_auth_entry_to_signin"
            app:destination="@id/navigation_signin" />
    </fragment>

    <navigation
        android:id="@+id/navigation_signup"
        android:label="@string/auth_entry_start"
        app:startDestination="@id/navigation_email">
        <fragment
            android:id="@+id/navigation_email"
            android:name="com.example.delibuddy.ui.signup.EmailFragment"
            android:label="@string/signup_email_title"
            tools:layout="@layout/fragment_email">
            <action
                android:id="@+id/action_email_to_password"
                app:destination="@id/navigation_password" />
        </fragment>
        <fragment
            android:id="@+id/navigation_password"
            android:name="com.example.delibuddy.ui.signup.PasswordFragment"
            android:label="@string/signup_password_title"
            tools:layout="@layout/fragment_password">
            <action
                android:id="@+id/action_password_to_birth_date"
                app:destination="@id/navigation_birth_date" />
            <action
                android:id="@+id/action_password_to_home"
                app:destination="@id/navigation_home"
                app:popUpTo="@id/navigation_auth_entry"
                app:popUpToInclusive="true"
                app:launchSingleTop="true" />
        </fragment>
        <fragment
            android:id="@+id/navigation_birth_date"
            android:name="com.example.delibuddy.ui.signup.BirthDateFragment"
            android:label="@string/signup_birth_date_title"
            tools:layout="@layout/fragment_birth_date">
            <action
                android:id="@+id/action_birth_date_to_account_info"
                app:destination="@id/navigation_account_info" />
        </fragment>
        <fragment
            android:id="@+id/navigation_account_info"
            android:name="com.example.delibuddy.ui.signup.AccountInfoFragment"
            android:label="@string/signup_account_info_title"
            tools:layout="@layout/fragment_account_info">
            <action
                android:id="@+id/action_account_info_to_home"
                app:destination="@id/navigation_home"
                app:popUpTo="@id/navigation_signup"
                app:popUpToInclusive="true"
                app:launchSingleTop="true" />
        </fragment>
    </navigation>

    <fragment
        android:id="@+id/navigation_signin"
        android:name="com.example.delibuddy.ui.signin.SignInFragment"
        android:label="@string/auth_signin"
        tools:layout="@layout/fragment_signin">
        <action
            android:id="@+id/action_signin_to_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/navigation_auth_entry"
            app:popUpToInclusive="true"
            app:launchSingleTop="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.delibuddy.ui.home.HomeFragment"
        android:label="@string/home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_create_room"
            app:destination="@+id/navigation_create_room" />

        <action
            android:id="@+id/action_home_to_room_detail"
            app:destination="@+id/navigation_room_detail" />

    </fragment>

    <fragment
        android:id="@+id/navigation_create_room"
        android:name="com.example.delibuddy.ui.room.create.CreateRoomFragment"
        android:label="방 만들기"
        tools:layout="@layout/fragment_create_room" />

    <fragment
        android:id="@+id/navigation_room_detail"
        android:name="com.example.delibuddy.ui.room.detail.RoomDetailFragment"
        android:label="@string/detail_title"
        tools:layout="@layout/fragment_room_detail">
        <argument
            android:name="roomId"
            app:argType="string" />

        <action
            android:id="@+id/action_room_detail_to_chat"
            app:destination="@id/navigation_chat" />
    </fragment>

    <fragment
        android:id="@+id/navigation_recommendation"
        android:name="com.example.delibuddy.ui.recommendation.RecommendationFragment"
        android:label="@string/location_recommendation"
        tools:layout="@layout/fragment_recommendation" />

    <fragment
        android:id="@+id/navigation_chat"
        android:name="com.example.delibuddy.ui.chat.ChatFragment"
        android:label="@string/chatting"
        tools:layout="@layout/fragment_chat">
        <!-- 방 상세에서 올 때만 값 있음, 하단 탭으로 오면 null -->
        <argument
            android:name="roomId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_mypage"
        android:name="com.example.delibuddy.ui.mypage.MyPageFragment"
        android:label="@string/my_page"
        tools:layout="@layout/fragment_mypage" />

</navigation>
