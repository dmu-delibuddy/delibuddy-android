<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 버튼 픽셀 그림자 -->
    <item android:top="@dimen/pixel_shadow" android:left="@dimen/pixel_shadow">
        <shape android:shape="rectangle">
            <solid android:color="@color/navy" />
        </shape>
    </item>
    <!-- 버튼 본체 -->
    <item
        android:bottom="@dimen/pixel_shadow"
        android:right="@dimen/pixel_shadow">
        <shape android:shape="rectangle">
            <solid android:color="?attr/globalAlertButtonFill" />
            <stroke android:width="@dimen/pixel_stroke" android:color="@color/navy" />
        </shape>
    </item>
</layer-list>
