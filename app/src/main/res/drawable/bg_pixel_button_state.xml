<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item
                android:left="@dimen/pixel_shadow"
                android:top="@dimen/pixel_shadow">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_disabled_line" />
                </shape>
            </item>
            <item
                android:right="@dimen/pixel_shadow"
                android:bottom="@dimen/pixel_shadow">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_disabled" />
                    <stroke
                        android:width="@dimen/pixel_stroke"
                        android:color="@color/button_disabled_line" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/bg_pixel_button" />
</selector>
