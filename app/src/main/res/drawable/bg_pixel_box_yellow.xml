<?xml version="1.0" encoding="utf-8"?>
<!-- 노란 바탕 + 검은 테두리 + 오른쪽 아래 픽셀 그림자 (마이페이지 송금 계좌 카드) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 그림자 -->
    <item
        android:left="@dimen/pixel_shadow"
        android:top="@dimen/pixel_shadow">
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
        </shape>
    </item>
    <!-- 본체 -->
    <item
        android:right="@dimen/pixel_shadow"
        android:bottom="@dimen/pixel_shadow">
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_selected" />
            <stroke
                android:width="@dimen/pixel_stroke"
                android:color="@color/black" />
        </shape>
    </item>
</layer-list>
