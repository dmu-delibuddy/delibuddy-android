<?xml version="1.0" encoding="utf-8"?>
<!-- 모드 버튼 (픽업만 / 밥친구): 선택 = 주황, 아니면 연노랑 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 선택됨 -->
    <item android:state_checked="true">
        <layer-list>
            <item android:left="@dimen/pixel_shadow" android:top="@dimen/pixel_shadow">
                <shape android:shape="rectangle">
                    <solid android:color="@color/black" />
                </shape>
            </item>
            <item android:right="@dimen/pixel_shadow" android:bottom="@dimen/pixel_shadow">
                <shape android:shape="rectangle">
                    <solid android:color="@color/point_orange" />
                    <stroke android:width="@dimen/pixel_stroke" android:color="@color/black" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 선택 안 됨 -->
    <item>
        <layer-list>
            <item android:left="@dimen/pixel_shadow" android:top="@dimen/pixel_shadow">
                <shape android:shape="rectangle">
                    <solid android:color="@color/black" />
                </shape>
            </item>
            <item android:right="@dimen/pixel_shadow" android:bottom="@dimen/pixel_shadow">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mode_off" />
                    <stroke android:width="@dimen/pixel_stroke" android:color="@color/black" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
