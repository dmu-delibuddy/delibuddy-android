<?xml version="1.0" encoding="utf-8"?>
<!-- 프로필 수정 창 : 사진 / 닉네임 / 한 줄 소개 / 생년월일 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pixel_box"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="23dp"
    android:paddingBottom="23dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 제목 : 코드에서 "픽업만 프로필 수정" 처럼 모드를 붙임 -->
        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mypage_edit_profile_title"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 프로필 사진 : 누르면 사진 선택 -->
        <FrameLayout
            android:id="@+id/layout_profile_image"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/image_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pixel_box"
                android:contentDescription="@string/mypage_profile_image_desc"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="7dp"
                android:paddingBottom="7dp"
                android:scaleType="centerCrop"
                android:src="@drawable/mypage_icon" />
        </FrameLayout>

        <!-- 기본 사진으로 되돌리기 -->
        <TextView
            android:id="@+id/button_remove_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp"
            android:text="@string/mypage_remove_image"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.7"
            android:text="@string/mypage_nickname_label"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edit_nickname"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pixel_box"
            android:hint="@string/mypage_nickname_hint"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLength="12"
            android:paddingStart="12dp"
            android:paddingEnd="15dp"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.7"
            android:text="@string/mypage_bio_label"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edit_bio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pixel_box"
            android:hint="@string/mypage_bio_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="40"
            android:paddingStart="12dp"
            android:paddingEnd="15dp"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.7"
            android:text="@string/mypage_birth_label"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <!-- 생년월일 : 누르면 달력 (회원가입과 같은 yyyy-MM-dd 로 저장) -->
        <TextView
            android:id="@+id/text_birth"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pixel_box"
            android:gravity="center_vertical"
            android:hint="@string/mypage_birth_hint"
            android:paddingStart="12dp"
            android:paddingEnd="15dp"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/button_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pixel_box"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="19dp"
                android:paddingBottom="11dp"
                android:text="@string/mypage_cancel"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/button_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pixel_box_yellow"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="19dp"
                android:paddingBottom="11dp"
                android:text="@string/mypage_save"
                android:textColor="@color/black"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
