<?xml version="1.0" encoding="utf-8"?><!-- 방 만들기 4단계 : 금액 · 정산 방법 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_step4_heading"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="@string/create_step4_sub"
        android:textColor="@color/black"
        android:textSize="13sp" />

    <!-- 1. 최소 주문 금액 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/create_min_order_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <com.example.delibuddy.ui.common.PriceInput
        android:id="@+id/min_order_amount"
        style="@style/PriceInputStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:hint="@string/create_min_order_hint"
        android:maxLength="7"
        app:amountEditId="@+id/edit_min_order" />

    <!-- 2. 예상 배달비 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/create_delivery_fee_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <com.example.delibuddy.ui.common.PriceInput
        android:id="@+id/delivery_fee_amount"
        style="@style/PriceInputStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:hint="@string/create_delivery_fee_hint"
        android:maxLength="7"
        app:amountEditId="@+id/edit_delivery_fee" />

    <!-- 1인당 예상 배달비 안내 (코드에서 채움) -->
    <TextView
        android:id="@+id/text_fee_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:textColor="@color/black"
        android:textSize="12sp" />

    <!-- 3. 음식값 정산 방법 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/create_food_split_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/group_food_split"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radio_food_host"
            style="@style/SplitChip"
            android:text="@string/split_host" />

        <RadioButton
            android:id="@+id/radio_food_equal"
            style="@style/SplitChip"
            android:text="@string/split_equal" />

        <RadioButton
            android:id="@+id/radio_food_by_menu"
            style="@style/SplitChip"
            android:text="@string/split_by_menu"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radio_food_custom"
            style="@style/SplitChip"
            android:text="@string/split_custom" />
    </RadioGroup>

    <TextView
        android:id="@+id/text_food_split_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:textColor="@color/black"
        android:textSize="12sp" />

    <!-- 4. 배달비 정산 방법 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/create_delivery_split_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/group_delivery_split"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radio_delivery_host"
            style="@style/SplitChip"
            android:text="@string/split_host" />

        <RadioButton
            android:id="@+id/radio_delivery_equal"
            style="@style/SplitChip"
            android:text="@string/split_equal"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radio_delivery_custom"
            style="@style/SplitChip"
            android:text="@string/split_custom" />
    </RadioGroup>
</LinearLayout>
