<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/app_bg"
    tools:context=".ui.room.create.CreateRoomAmountFragment">

    <include
        android:id="@+id/header"
        layout="@layout/layout_create_room_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_step4_heading"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="@string/create_step4_sub"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/create_min_order_label"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <com.example.delibuddy.ui.common.PriceInput
                android:id="@+id/min_order_amount"
                style="@style/PriceInputStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="@string/create_min_order_hint"
                android:maxLength="7"
                app:amountEditId="@+id/edit_min_order" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/create_delivery_fee_label"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <com.example.delibuddy.ui.common.PriceInput
                android:id="@+id/delivery_fee_amount"
                style="@style/PriceInputStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="@string/create_delivery_fee_hint"
                android:maxLength="7"
                app:amountEditId="@+id/edit_delivery_fee" />

            <TextView
                android:id="@+id/text_fee_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/create_food_split_label"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/group_food_split"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_food_host"
                    style="@style/SplitChip"
                    android:text="@string/split_host" />

                <RadioButton
                    android:id="@+id/radio_food_equal"
                    style="@style/SplitChip"
                    android:text="@string/split_equal" />

                <RadioButton
                    android:id="@+id/radio_food_by_menu"
                    style="@style/SplitChip"
                    android:text="@string/split_by_menu"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radio_food_custom"
                    style="@style/SplitChip"
                    android:text="@string/split_custom" />
            </RadioGroup>

            <TextView
                android:id="@+id/text_food_split_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/create_delivery_split_label"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/group_delivery_split"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_delivery_host"
                    style="@style/SplitChip"
                    android:text="@string/split_host" />

                <RadioButton
                    android:id="@+id/radio_delivery_equal"
                    style="@style/SplitChip"
                    android:text="@string/split_equal"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radio_delivery_custom"
                    style="@style/SplitChip"
                    android:text="@string/split_custom" />
            </RadioGroup>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottom"
        layout="@layout/layout_create_room_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
