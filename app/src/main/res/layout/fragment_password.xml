<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:fillViewport="true"
    tools:context=".ui.signup.PasswordFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <include
            android:id="@+id/signup_progress"
            layout="@layout/layout_signup_progress" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/signup_password_title"
            android:textColor="@color/navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SignupInputLabel"
            android:layout_marginTop="32dp"
            android:labelFor="@id/edit_password"
            android:text="@string/auth_password_hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/signup_Input"
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_password"
                style="@style/SignupEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/SignupInputLabel"
            android:labelFor="@id/edit_password_confirm"
            android:text="@string/signup_password_confirm_hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/signup_Input"
            android:id="@+id/input_password_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_password_confirm"
                style="@style/SignupEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_verify_email"
            style="@style/PixelButton.Orange"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="@string/signup_verification_email_send" />

        <TextView
            android:id="@+id/text_verification_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_dashed_box"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="@string/signup_verification_guide"
            android:textColor="@color/navy"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_verification_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/signup_verification_confirmed"
            android:textColor="@color/navy"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_previous"
                style="@style/PixelButton.Yellow"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/signup_previous" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_verification_complete"
                style="@style/PixelButton.Red"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="@string/signup_verification_complete" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
