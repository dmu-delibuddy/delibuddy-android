<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:fillViewport="true"
    tools:context=".ui.signup.AccountInfoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <include
            android:id="@+id/signup_progress"
            layout="@layout/layout_signup_progress" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/signup_account_info_title"
            android:textColor="@color/navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/signup_account_info_description"
            android:textColor="@color/navy"
            android:textSize="14sp" />

        <TextView
            style="@style/SignupInputLabel"
            android:labelFor="@id/spinner_bank"
            android:text="@string/signup_bank_name_hint" />

        <Spinner
            android:id="@+id/spinner_bank"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pixel_spinner"
            android:paddingStart="6dp"
            android:paddingEnd="44dp"
            android:paddingBottom="@dimen/pixel_shadow" />

        <TextView
            style="@style/SignupInputLabel"
            android:labelFor="@id/edit_account"
            android:text="@string/signup_account_hint" />

        <EditText
            android:id="@+id/edit_account"
            style="@style/SignupEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/signup_account_placeholder"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1"
            android:saveEnabled="false" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_previous"
                style="@style/PixelButton.Yellow"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/signup_previous" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_skip"
                style="@style/PixelButton.Yellow"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/signup_skip" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_finish"
            style="@style/PixelButton.Red"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/signup_finish" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
