<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:fillViewport="true"
    tools:context=".ui.signup.EmailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <include
            android:id="@+id/signup_progress"
            layout="@layout/layout_signup_progress" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/signup_email_title"
            android:textColor="@color/navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SignupInputLabel"
            android:layout_marginTop="32dp"
            android:labelFor="@id/edit_email"
            android:text="@string/auth_email_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pixel_box"
            android:orientation="horizontal"
            android:paddingStart="@dimen/pixel_stroke"
            android:paddingTop="@dimen/pixel_stroke"
            android:paddingEnd="5dp"
            android:paddingBottom="5dp">

            <EditText
                android:id="@+id/edit_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="emailAddress"
                android:background="@null"
                android:hint="@string/signup_email_id_hint"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:minHeight="45dp"
                android:paddingHorizontal="12dp"
                android:textColor="@color/navy"
                android:textSize="16sp" />

            <View
                android:layout_width="@dimen/pixel_stroke"
                android:layout_height="match_parent"
                android:background="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@color/mode_off"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/auth_email_domain"
                android:textColor="@color/navy"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_next"
            style="@style/PixelButton.Red"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="@string/signup_next" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
