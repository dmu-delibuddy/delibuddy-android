<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:fillViewport="true"
    tools:context=".ui.signup.BirthDateFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <include
            android:id="@+id/signup_progress"
            layout="@layout/layout_signup_progress" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/signup_birth_date_title"
            android:textColor="@color/navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SignupInputLabel"
            android:layout_marginTop="32dp"
            android:labelFor="@id/button_birth_date"
            android:text="@string/signup_birth_date_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_birth_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pixel_box"
            android:gravity="start|center_vertical"
            android:letterSpacing="0"
            android:minHeight="52dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="17dp"
            android:paddingBottom="15dp"
            android:stateListAnimator="@null"
            android:text="@string/signup_birth_date_hint"
            android:textAllCaps="false"
            android:textColor="@color/navy"
            android:textSize="16sp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_pixel_calendar"
            app:iconGravity="end"
            app:iconTint="@color/navy"
            android:insetBottom="0dp"
            android:insetTop="0dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_skip"
                style="@style/PixelButton.Yellow"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/signup_skip" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_next"
                style="@style/PixelButton.Red"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="@string/signup_next" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
