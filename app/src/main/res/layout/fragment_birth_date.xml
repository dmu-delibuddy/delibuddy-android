<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:fillViewport="true"
    tools:context=".ui.signup.BirthDateFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <ProgressBar
            android:id="@+id/signup_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:indeterminate="false"
            android:max="4"
            android:progress="3"
            android:progressBackgroundTint="@color/white"
            android:progressTint="@color/nav_selected" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/signup_birth_date_title"
            android:textColor="@color/navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:background="@drawable/bg_pixel_box"
            android:textColor="@color/black"
            android:textAllCaps="false"
            app:backgroundTint="@null"
            android:id="@+id/button_birth_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_marginTop="32dp"
            android:text="@string/signup_birth_date_hint"
            android:textSize="18sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
            android:background="@drawable/bg_pixel_box"
            android:textColor="@color/black"
            android:textAllCaps="false"
            app:backgroundTint="@null"
                android:id="@+id/button_skip"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/signup_skip"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
            android:background="@drawable/bg_pixel_box_yellow"
            android:textColor="@color/black"
            android:textAllCaps="false"
            app:backgroundTint="@null"
                android:id="@+id/button_next"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="@string/signup_next"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
