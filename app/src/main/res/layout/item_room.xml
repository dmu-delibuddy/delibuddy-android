<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_pixel_box"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="13dp"
    android:paddingBottom="11dp">

    <TextView
        android:id="@+id/text_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_yellow"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/badge_text"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/image_participants"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/image_participants"
        tools:text="@string/detail_status_recruiting" />

    <ImageView
        android:id="@+id/image_participants"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/participants_icon"
        app:layout_constraintStart_toEndOf="@id/text_status"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_participant_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:textColor="@color/black"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/image_participants"
        app:layout_constraintStart_toEndOf="@id/image_participants"
        app:layout_constraintTop_toTopOf="@id/image_participants"
        tools:text="2/3" />

    <TextView
        android:id="@+id/text_delivery_fee"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.8"
        android:textColor="@color/black"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/image_participants"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/image_participants"
        tools:text="배달비 1인당 1,500원" />

    <LinearLayout
        android:id="@+id/row_delivery_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@id/text_participant_count"
        app:layout_constraintTop_toBottomOf="@id/image_participants">

        <ImageView
            android:id="@+id/image_delivery_app"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            tools:src="@drawable/icon_delivery_baemin" />

        <TextView
            android:id="@+id/text_delivery_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="12sp"
            tools:text="@string/delivery_app_baemin" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/black"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/row_delivery_app"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/image_participants"
        tools:text="맘스터치 싸이버거 드실 분" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_title_and_delivery_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="text_title,row_delivery_app" />

    <TextView
        android:id="@+id/text_restaurant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#666666"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/text_mode"
        app:layout_constraintEnd_toStartOf="@id/text_mode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/text_mode"
        tools:text="맘스터치" />

    <include
        android:id="@+id/text_mode"
        layout="@layout/layout_mode_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier_title_and_delivery_app" />

</androidx.constraintlayout.widget.ConstraintLayout>
