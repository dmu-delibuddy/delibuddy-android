<?xml version="1.0" encoding="utf-8"?>
<!-- 방 만들기 1단계 : 방 정보 (제목 · 인원 · 모드) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_step1_heading"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="@string/create_step1_sub"
        android:textColor="@color/black"
        android:textSize="13sp" />

    <!-- 1. 방 제목 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/create_title_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/edit_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pixel_box"
        android:hint="@string/create_title_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="30"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="15dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_title_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="0/30"
        android:textColor="@color/black"
        android:textSize="12sp" />

    <!-- 2. 최대 참가자 수 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/create_participants_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/button_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_pixel_box"
            android:gravity="center"
            android:paddingEnd="3dp"
            android:paddingBottom="3dp"
            android:text="-"
            android:textColor="@color/black"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/text_participants"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:text="4명" />

        <TextView
            android:id="@+id/button_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_pixel_box"
            android:gravity="center"
            android:paddingEnd="3dp"
            android:paddingBottom="3dp"
            android:text="+"
            android:textColor="@color/black"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 3. 모드 선택 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/create_mode_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/group_create_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radio_create_pickup"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_button"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:text="@string/create_mode_pickup"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/radio_create_meal_buddy"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_button"
            android:button="@null"
            android:gravity="center"
            android:text="@string/create_mode_meal_buddy"
            android:textColor="@color/black"
            android:textSize="13sp" />
    </RadioGroup>

</LinearLayout>