<?xml version="1.0" encoding="utf-8"?>
<!-- 방 만들기 3단계 : 장소 · 배달 앱 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_step3_heading"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="@string/create_step3_sub"
        android:textColor="@color/black"
        android:textSize="13sp" />

    <!-- 1. 장소 (저장 방식 정해지면 선택 기능 추가) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/create_place_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_place"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:alpha="0.5"
        android:background="@drawable/bg_pixel_box"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="15dp"
        android:text="@string/create_place_pending"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <!-- 2. 배달 앱 : 배민 / 쿠팡이츠 / 요기요 는 아이콘, 그 외는 직접 입력 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/create_delivery_app_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/group_delivery_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radio_app_baemin"
            style="@style/DeliveryAppIconChip"
            android:contentDescription="@string/delivery_app_baemin"
            android:drawableTop="@drawable/icon_delivery_baemin" />

        <RadioButton
            android:id="@+id/radio_app_coupang"
            style="@style/DeliveryAppIconChip"
            android:contentDescription="@string/delivery_app_coupang_eats"
            android:drawableTop="@drawable/icon_delivery_coupang_eats" />

        <RadioButton
            android:id="@+id/radio_app_yogiyo"
            style="@style/DeliveryAppIconChip"
            android:contentDescription="@string/delivery_app_yogiyo"
            android:drawableTop="@drawable/icon_delivery_yogiyo" />

        <RadioButton
            android:id="@+id/radio_app_other"
            style="@style/SplitChip"
            android:layout_height="48dp"
            android:layout_marginEnd="0dp"
            android:text="@string/delivery_app_other" />
    </RadioGroup>

    <!-- "직접 입력"을 골랐을 때만 보임 -->
    <EditText
        android:id="@+id/edit_delivery_app"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pixel_box"
        android:hint="@string/create_delivery_app_name_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="15"
        android:paddingStart="12dp"
        android:paddingEnd="15dp"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
