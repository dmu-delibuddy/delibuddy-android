<?xml version="1.0" encoding="utf-8"?>
<!-- 방 만들기 3단계 : 장소 · 마감 시간 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_step3_heading"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="@string/create_step3_sub"
        android:textColor="@color/black"
        android:textSize="13sp" />

    <!-- 1. 장소 (저장 방식 정해지면 선택 기능 추가) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/create_place_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_place"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:alpha="0.5"
        android:background="@drawable/bg_pixel_box"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="15dp"
        android:text="@string/create_place_pending"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <!-- 2. 마감 시간 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/create_deadline_label"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/box_deadline"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pixel_box"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pixel_clock" />

        <TextView
            android:id="@+id/text_deadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="@string/create_deadline_hint"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="▼"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/check_no_time_limit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:buttonTint="@color/black"
        android:text="@string/create_no_time_limit"
        android:textColor="@color/black"
        android:textSize="13sp" />
</LinearLayout>