<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/order_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/bg_pixel_box"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/receipt_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 주문 내역"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="주문할 내용을 미리 입력해 주세요"
        android:textColor="#697080" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="음식값 * (배달비 제외)"
        android:textColor="@color/black" />

    <EditText
        android:id="@+id/input_order_price"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pixel_box"
        android:gravity="end|center_vertical"
        android:hint="0 원"
        android:inputType="number"
        android:maxLength="10"
        android:textColor="@color/black" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="장바구니 사진"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/image_order_preview"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pixel_box"
        android:contentDescription="장바구니 사진 올리기"
        android:scaleType="centerInside"
        android:src="@drawable/add_picture_icon" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="장바구니 사진 올리기 메뉴와 금액이 보이도록 캡처해 주세요"
        android:textColor="#697080" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="메모  (선택)"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/input_order_memo"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pixel_box"
        android:gravity="top"
        android:hint="맵기, 메뉴 옵션 등 전달할 내용을 적어 주세요"
        android:inputType="textMultiLine"
        android:maxLength="100"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_memo_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="0/100"
        android:textColor="#697080" />

    <TextView
        android:id="@+id/text_order_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#697080" />
</LinearLayout>
