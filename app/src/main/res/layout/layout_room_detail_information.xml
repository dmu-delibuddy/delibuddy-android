<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/bg_pixel_box"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="17dp"
    android:paddingBottom="15dp">

    <TextView android:id="@+id/text_restaurant"
        style="@style/DetailRow" />
    <TextView android:id="@+id/text_deadline"
        style="@style/DetailRow" />
    <TextView android:id="@+id/text_min_order"
        style="@style/DetailRow" />
    <TextView android:id="@+id/text_delivery_fee"
        style="@style/DetailRow" />
    <TextView android:id="@+id/text_food_split"
        style="@style/DetailRow" />
    <TextView android:id="@+id/text_delivery_split"
        style="@style/DetailRow" />
</LinearLayout>
