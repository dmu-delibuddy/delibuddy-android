<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android=
        "http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pixel_box"
    android:orientation="vertical"
    android:paddingEnd="3dp"
    android:paddingBottom="3dp">

    <!-- 접힌 줄: 누르면 펼치기/접기 -->
    <LinearLayout
        android:id="@+id/row_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background=
            "?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/text_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background=
                "@drawable/bg_badge_orange"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="모집 중" />

        <TextView
            android:id="@+id/text_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="14sp"
            tools:text="3/4명 · 1명 더 모이면 마감" />

        <ImageView
            android:id="@+id/image_expand"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription=
                "@string/notice_expand_desc"
            android:src=
                "@android:drawable/arrow_down_float"
            app:tint="@color/black" />
    </LinearLayout>

    <!-- 펼친 부분 -->
    <LinearLayout
        android:id="@+id/layout_expanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000" />

        <!-- 4단계 진행 바 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/step_1"
                style="@style/NoticeStepCircle"
                app:layout_constraintHorizontal_chainStyle=
                    "spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/step_2"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/step_2"
                style="@style/NoticeStepCircle"
                app:layout_constraintStart_toEndOf="@id/step_1"
                app:layout_constraintEnd_toStartOf="@id/step_3"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/step_3"
                style="@style/NoticeStepCircle"
                app:layout_constraintStart_toEndOf="@id/step_2"
                app:layout_constraintEnd_toStartOf="@id/step_4"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/step_4"
                style="@style/NoticeStepCircle"
                app:layout_constraintStart_toEndOf="@id/step_3"
                app:layout_constraintEnd_toStartOf="@id/step_5"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/step_5"
                style="@style/NoticeStepCircle"
                app:layout_constraintStart_toEndOf="@id/step_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/line_1"
                style="@style/NoticeStepLine"
                app:layout_constraintStart_toEndOf="@id/step_1"
                app:layout_constraintEnd_toStartOf="@id/step_2"
                app:layout_constraintTop_toTopOf="@id/step_1"
                app:layout_constraintBottom_toBottomOf=
                    "@id/step_1" />

            <View
                android:id="@+id/line_2"
                style="@style/NoticeStepLine"
                app:layout_constraintStart_toEndOf="@id/step_2"
                app:layout_constraintEnd_toStartOf="@id/step_3"
                app:layout_constraintTop_toTopOf="@id/step_2"
                app:layout_constraintBottom_toBottomOf=
                    "@id/step_2" />

            <View
                android:id="@+id/line_3"
                style="@style/NoticeStepLine"
                app:layout_constraintStart_toEndOf="@id/step_3"
                app:layout_constraintEnd_toStartOf="@id/step_4"
                app:layout_constraintTop_toTopOf="@id/step_3"
                app:layout_constraintBottom_toBottomOf=
                    "@id/step_3" />

            <View
                android:id="@+id/line_4"
                style="@style/NoticeStepLine"
                app:layout_constraintStart_toEndOf="@id/step_4"
                app:layout_constraintEnd_toStartOf="@id/step_5"
                app:layout_constraintTop_toTopOf="@id/step_4"
                app:layout_constraintBottom_toBottomOf=
                    "@id/step_4" />

            <TextView
                style="@style/NoticeStepLabel"
                android:text="@string/notice_step_recruiting"
                app:layout_constraintStart_toStartOf="@id/step_1"
                app:layout_constraintEnd_toEndOf="@id/step_1"
                app:layout_constraintTop_toBottomOf="@id/step_1" />

            <TextView
                style="@style/NoticeStepLabel"
                android:text="@string/notice_step_confirmed"
                app:layout_constraintStart_toStartOf="@id/step_2"
                app:layout_constraintEnd_toEndOf="@id/step_2"
                app:layout_constraintTop_toBottomOf="@id/step_2" />

            <TextView
                style="@style/NoticeStepLabel"
                android:text="@string/notice_step_ordered"
                app:layout_constraintStart_toStartOf="@id/step_3"
                app:layout_constraintEnd_toEndOf="@id/step_3"
                app:layout_constraintTop_toBottomOf="@id/step_3" />

            <TextView
                style="@style/NoticeStepLabel"
                android:text="@string/notice_step_received"
                app:layout_constraintStart_toStartOf="@id/step_4"
                app:layout_constraintEnd_toEndOf="@id/step_4"
                app:layout_constraintTop_toBottomOf="@id/step_4" />

            <TextView
                style="@style/NoticeStepLabel"
                android:text="@string/notice_step_completed"
                app:layout_constraintStart_toStartOf="@id/step_5"
                app:layout_constraintEnd_toEndOf="@id/step_5"
                app:layout_constraintTop_toBottomOf="@id/step_5" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/text_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#444444"
            android:textSize="12sp"
            tools:text="모두 메뉴를 담으면 주문을 확정해 주세요" />

        <!-- 방장만 보임 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/button_red"
            app:cornerRadius="0dp"
            app:strokeColor="@color/black"
            app:strokeWidth="2dp"
            tools:text="주문 확정하기"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>