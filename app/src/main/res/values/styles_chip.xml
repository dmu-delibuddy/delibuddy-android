<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 홈 화면 카테고리 버튼 -->
    <style name="CategoryChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_category_chip</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 방 만들기 정산 방법 버튼 (CategoryChip 에서 높이·글자만 변경) -->
    <style name="SplitChip" parent="CategoryChip">
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 방 만들기 배달 앱 아이콘 버튼 (CategoryChip 에서 높이·아이콘 위치만 변경) -->
    <style name="DeliveryAppIconChip" parent="CategoryChip">
        <item name="android:layout_height">48dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
</resources>
