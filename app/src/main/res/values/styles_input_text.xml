<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="signup_Input">
        <item name="boxBackgroundMode">none</item>
        <item name="hintEnabled">false</item>
        <item name="endIconTint">@color/navy</item>
    </style>

    <style name="SignupEditText">
        <item name="android:background">@drawable/bg_pixel_box</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">17dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SignupInputLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
