<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="globalAlertIcon" format="reference" />
    <attr name="globalAlertButtonFill" format="color" />
    <attr name="globalAlertConfirmTextColor" format="color" />

    <style name="GlobalAlertDialogTheme">
        <item name="globalAlertIcon">@drawable/alert_question</item>
        <item name="globalAlertButtonFill">@color/point_orange</item>
        <item name="globalAlertConfirmTextColor">@color/navy</item>
    </style>

    <style name="GlobalAlertDialogDangerTheme" parent="GlobalAlertDialogTheme">
        <item name="globalAlertIcon">@drawable/alert_warning</item>
        <item name="globalAlertButtonFill">@color/button_red</item>
        <item name="globalAlertConfirmTextColor">@color/white</item>
    </style>

    <style name="GlobalAlertDialogInfoTheme" parent="GlobalAlertDialogTheme">
        <item name="globalAlertIcon">@drawable/alert_info</item>
        <item name="globalAlertButtonFill">@color/mode_off</item>
    </style>

    <style name="GlobalAlertDialogCancelButtonTheme">
        <item name="globalAlertButtonFill">@color/mode_off</item>
    </style>
</resources>
