<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BirthDatePickerDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:datePickerStyle">@style/BirthDateSpinner</item>
        <item name="android:colorAccent">@color/navy</item>
    </style>

    <style name="BirthDateSpinner" parent="android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
        <item name="android:spinnersShown">true</item>
    </style>
</resources>
