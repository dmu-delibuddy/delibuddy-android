<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">0dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="ActionButton.Primary">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/button_red</item>
    </style>

    <style name="ActionButton.Secondary">
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/mode_off</item>
    </style>

    <style name="PixelButton">
        <item name="android:background">@drawable/bg_pixel_button_state</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pixel_button_text</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="PixelButton.Red">
        <item name="android:theme">@style/GlobalAlertDialogDangerTheme</item>
    </style>

    <style name="PixelButton.Orange">
        <item name="android:theme">@style/GlobalAlertDialogTheme</item>
    </style>

    <style name="PixelButton.Yellow">
        <item name="android:theme">@style/GlobalAlertDialogInfoTheme</item>
    </style>
</resources>
