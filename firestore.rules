rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null;

      // 채팅 : 같은 방 참여자(방장 포함)만 읽고 쓰기
      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);
        // 일반 메시지는 본인 이름으로만, 시스템 메시지는 보낸 사람 없이
        allow create: if isRoomMember(roomId) && (
          request.resource.data.senderId == request.auth.uid
          || (request.resource.data.type == 'SYSTEM'
              && request.resource.data.senderId == null)
        );
      }

      match /orders/{userId} {
        function isParticipant() {
          return request.auth != null
                 && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participantIds;
        }

        function canEdit() {
          let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
          return isParticipant()
                 && request.auth.uid == userId
                 && room.status in ['RECRUITING', 'FULL']
                 && (room.deadline == null || request.time < room.deadline);
        }

        allow read: if isParticipant();
        allow create, update: if canEdit()
                              && request.resource.data.keys().hasAll(['price'])
                              && request.resource.data.keys().hasOnly(['price', 'cartScreenshotUrl', 'memo'])
                              && request.resource.data.price is int
                              && request.resource.data.price >= 0
                              && (request.resource.data.get('cartScreenshotUrl', null) == null
                                  || request.resource.data.cartScreenshotUrl is string)
                              && (request.resource.data.get('memo', null) == null
                                  || request.resource.data.memo is string);
        allow delete: if canEdit();
      }
    }

    function isRoomMember(roomId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participantIds;
    }

    match /test/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
                    && request.resource.data.keys().hasOnly(['message'])
                    && request.resource.data.message is string;
    }

    match /users/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.auth.token.email_verified == true;

      allow read, update, delete: if request.auth != null
                                 && request.auth.uid == userId
                                 && request.auth.token.email_verified == true;
    }

    match /profiles/{userId}/types/{profileType} {
      allow read, write: if request.auth != null
                        && request.auth.uid == userId
                        && request.auth.token.email_verified == true
                        && profileType in ['PICKUP_ONLY', 'MEAL_BUDDY'];
    }

    match /images/{imageId} {
      allow read, write: if request.auth != null;
    }
  }
}
