rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /recommend-locations/{locationId} {
      allow read: if true;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null;

      // 채팅 : 같은 방 참여자(방장 포함)만 읽고 쓰기
      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);
        // 일반 메시지는 본인 이름으로만, 시스템 메시지는 보낸 사람 없이
        allow create: if request.auth != null && (
          (isRoomMember(roomId)
              && request.resource.data.senderId == request.auth.uid)
          || (request.resource.data.type == 'SYSTEM'
              && request.resource.data.senderId == null
              && (isRoomMember(roomId) || isRoomMemberAfter(roomId)))
        );
      }

      match /orders/{userId} {
        function isParticipant() {
          return request.auth != null
                 && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participantIds;
        }

        function canEdit() {
          let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
          return isParticipant()
                 && request.auth.uid == userId
                 && room.status == 'RECRUITING';
        }

        allow read: if isParticipant();
        allow create, update: if canEdit()
                              && request.resource.data.keys().hasAll(['price'])
                              && request.resource.data.keys().hasOnly(['price', 'imageId', 'memo'])
                              && request.resource.data.price is int
                              && request.resource.data.price >= 0
                              && (request.resource.data.get('imageId', null) == null
                                  || (request.resource.data.imageId is string
                                      && request.resource.data.imageId.size() > 0))
                              && (request.resource.data.get('memo', null) == null
                                  || request.resource.data.memo is string);
        allow delete: if canEdit();
      }
    }

    function isRoomMember(roomId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participantIds;
    }

    // 방 생성·참여와 함께 기록하는 시스템 메시지는 변경 후 참여자를 확인한다.
    function isRoomMemberAfter(roomId) {
      return request.auth != null
        && existsAfter(/databases/$(database)/documents/rooms/$(roomId))
        && request.auth.uid in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.participantIds;
    }

    match /test/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
                    && request.resource.data.keys().hasOnly(['message'])
                    && request.resource.data.message is string;
    }

    match /users/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.auth.token.email_verified == true;

      allow read, update, delete: if request.auth != null
                                 && request.auth.uid == userId
                                 && request.auth.token.email_verified == true;
    }

    match /users/{userId}/profiles/{profileType} {
      allow read: if request.auth != null
                  && request.auth.token.email_verified == true
                  && profileType in ['PICKUP_ONLY', 'MEAL_BUDDY'];
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.auth.token.email_verified == true
                   && profileType in ['PICKUP_ONLY', 'MEAL_BUDDY'];
    }

    match /images/{imageId} {
      allow read, write: if request.auth != null;
    }
  }
}
